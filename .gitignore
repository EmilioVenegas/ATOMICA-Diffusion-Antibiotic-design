# ── Python runtime artifacts ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/

# ── ML data, checkpoints, logs ───────────────────────────────────────────────
# Training data and run logs are reproducible from the preprocessing scripts and
# are far too large to version. Model weights already tracked in history stay
# tracked; new ones should ship as GitHub Release assets instead.
data/
my_logs/
wandb/
*.ckpt
*.pt
*.pkl
*.lmdb
*.lmdb-lock
*.npy
*.jsonl.gz

# ── Generated molecules ──────────────────────────────────────────────────────
# Raw generated structures run to tens of MB per ablation arm and are an output,
# not a source. The per-condition metrics that summarise them ARE versioned --
# see the negations under "evaluation evidence" below.
*.sdf
*.pdbqt
*.mol2
*.pdb

# ── Docking scratch ──────────────────────────────────────────────────────────
# Per-ligand Vina logs are raw tool output; the aggregated scores.csv is the
# artifact worth keeping.
docking/**/*.pdbqt
docking/**/*.log
docking/*_log.txt
docking/config.txt

# ── Run state ────────────────────────────────────────────────────────────────
# Resume bookkeeping for interrupted evaluation runs, not a result.
results/**/filtered/checkpoint.json

# ── Evaluation evidence (deliberately versioned) ─────────────────────────────
# These are the artifacts that back the numbers quoted in the README. They are
# small, they are the record of what was actually run, and they must survive the
# broad ignores above -- an earlier revision of this file silently excluded them.
!results/
!results/**/metrics.json
!results/**/meta.json
!results/**/*.md
!results/figures/
!results/figures/*.png
!docking/scores.csv

# ── Environment / IDE ────────────────────────────────────────────────────────
.claude/settings.local.json
.env
.venv/
*.egg
.DS_Store
.idea/
.vscode/
